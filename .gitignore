# CI zips every tracked file, so keep data, runs and weights out of git.

# Datasets (keep pov_med tracked for the training team)
datasets/*
!datasets/pov_med/
data/
splits/
*.zip

# Training and inference outputs
runs/
outputs/
submission/

# Weights and exported models
*.pt
*.pth
*.onnx
*.engine
*.torchscript

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Ultralytics caches
*.cache
